# AgentPay — environment template.
# Copy to .env and fill in. NEVER commit a real .env, and NEVER use a key that
# holds mainnet funds — Aevum Testnet only.
#
#   cp .env.example .env

# Deployer / owner private key (TESTNET ONLY, no 0x prefix needed)
PRIVATE_KEY=

# Agent key for the demo script (TESTNET ONLY, separate from the owner key)
AGENT_PRIVATE_KEY=

# Aevum Testnet (public, no secrets)
AEVUM_RPC_URL=https://rpc-test.qday.info
AEVUM_CHAIN_ID=44005
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Filled in after deploy (9–11 Dec build)
AGENT_VAULT_ADDRESS=
INVOICE_REGISTRY_ADDRESS=
